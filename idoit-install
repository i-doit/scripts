## Ask for the HTTPS mode before the first change of the system:
function askHTTPSMode {
    local mode=""

    log "HTTPS mode:"
    log ""
    log "    none         keep plain HTTP"
    log "    selfsigned   create a self-signed certificate"
    log "    custom       use your own certificate"
    log ""

    while true; do
        echo -n -e "Which HTTPS mode do you like to use? [none|selfsigned|custom, leave empty for '${IDOIT_HTTPS_MODE}']: "

        readAnswer

        mode="${answer:-$IDOIT_HTTPS_MODE}"
        mode="${mode,,}"

        case "$mode" in
        "none" | "selfsigned" | "custom")
            IDOIT_HTTPS_MODE="$mode"
            return 0
            ;;
        esac

        if isUnattended; then
            abort "Unknown HTTPS mode '${mode}'. Please set IDOIT_HTTPS_MODE to none, selfsigned or custom."
        fi

        log "Sorry, what do you mean?"
    done
}

## Stop before the first change of the system if the preset password cannot work:
function checkMariaDBIdoitPassword {
