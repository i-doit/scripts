## Piped into Bash (curl | bash) BASH_SOURCE is empty:
if [[ "${BASH_SOURCE[0]:-$0}" = "$0" ]]; then
    trap tearDown EXIT

    checkRequiredCommands

    ARGS=$(getopt \
        -o vh \
        --long help,version -- "$@") || {
        showUsage
        exit 1
    }

    eval set -- "$ARGS"

    while true; do
        case "$1" in
        -h | --help)
            showUsage
            exit 0
            ;;
        -v | --version)
            printVersion
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            log "Unknown option '${1}'."
            showUsage
            exit 1
            ;;
        esac
    done

    if [[ "$#" -gt 0 ]]; then
        log "Unknown argument '${1}'."
        showUsage
        exit 1
    fi

    setup
    execute
    finish
fi
