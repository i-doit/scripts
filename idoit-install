function execute {
    local status=0
    local ip_address=""
    local url=""

    log "Install i-doit on a GNU/Linux operating system"
    log ""
    log "Attention:"
    log "This script alters your OS. It will install new packages and will change configuration settings."
    log "Only use it on a fresh installation of a GNU/Linux OS."
    log "It comes with absolutely no warranty."
    log "Read the documentation carefully before you continue:"
    log ""
    log "    https://github.com/i-doit/scripts"
    log ""
    log "This script will automatically…"
    log ""
    log "    1) install additional distribution packages,"
    log "    2) alter configuration of your PHP environment,"
    log "    3) alter configuration of your Apache Web server including HTTPS,"
    log "    4) alter configuration of your MariaDB DBMS, and"
    log "    5) download and install the latest version of i-doit pro or open"
    log "    6) deploy cron jobs and an easy-to-use CLI tool for your i-doit instance"
    log "    7) deploy scripts to backup and restore your i-doit instance"
    log ""
    log "You may skip any step if you like."
    log ""

    askYesNo "Do you really want to continue?" || cancel

    log "\\n--------------------------------------------------------------------------------\\n"

    askHTTPSMode

    if [[ "$IDOIT_HTTPS_MODE" = "custom" ]]; then
        askCustomCertificate
    fi

    if [[ "$IDOIT_HTTPS_MODE" != "none" ]]; then
        checkHTTPSSettings
        askFQDN
    fi

    askVariant
    checkBufferPoolSize
    checkMariaDBIdoitPassword
    checkIDoitAdminPassword
    checkCronMailto
    identifyOS
    checkExistingInstallation
    checkRHELRepositories

    log "\\n--------------------------------------------------------------------------------\\n"

    checkHardwareRequirements

    log "\\n--------------------------------------------------------------------------------\\n"

    log "This script needs Web access (HTTP/HTTPS on ports 80/443)."
    if ! askNoYes "Do you want to configure a proxy server?"; then
        configureProxy
    fi

    checkHelperFiles "early"

    log "\\n--------------------------------------------------------------------------------\\n"

    if askYesNo "Do you want to configure the operating system?"; then
        configureOS
    fi

    ## Check the contents now if openssl was missing at the beginning:
    if [[ "$IDOIT_HTTPS_MODE" = "custom" ]]; then
        checkCustomCertificate
    fi

    log "\\n--------------------------------------------------------------------------------\\n"

    checkSoftwareRequirements
    checkHelperFiles

    log "\\n--------------------------------------------------------------------------------\\n"

    if askYesNo "Do you want to configure the PHP environment?"; then
        configurePHP
        configurePHPFPM
    fi

    log "\\n--------------------------------------------------------------------------------\\n"

    if askYesNo "Do you want to configure the Apache Web server?"; then
        configureApache

        log "\\n--------------------------------------------------------------------------------\\n"

        configureHTTPS
    fi

    log "\\n--------------------------------------------------------------------------------\\n"

    if askYesNo "Do you want to configure MariaDB?"; then
        configureMariaDB
    fi

    log "\\n--------------------------------------------------------------------------------\\n"

    if askYesNo "Do you want to download and install i-doit automatically?"; then
        prepareIDoit
        updateApacheConfig
        installIDoit

        if [[ -n "$HTTPS_URL" ]]; then
            url="$HTTPS_URL"
        else
            ip_address=$(primaryIP)
            url="http://${ip_address:-localhost}/"
        fi

        log "Your setup is ready. Navigate to"
        log ""
        log "    ${url}"
        log ""
        log "with your Web browser and login to the Admin Center 'admin' to create Tenants manually"

        if [[ "$IDOIT_HTTPS_MODE" = "selfsigned" && -n "$HTTPS_URL" ]]; then
            log ""
            log "The certificate is self-signed, so your Web browser will show a security warning."
            log "Replace it by a trusted certificate with IDOIT_HTTPS_MODE=custom."
        fi

        log "\\n--------------------------------------------------------------------------------\\n"

        if askYesNo "Do you want to create the initial i-doit tenant automatically?"; then
            create_tenant
        fi

        status=1
    else
        log "Your operating system is prepared for the installation of i-doit."
        log "To complete the setup please follow the instructions as described in the i-doit Knowledge Base:"
        log ""
        log "    https://kb.i-doit.com/en/installation/manual-installation/setup.html"
    fi

    if [[ "$status" = 1 ]] && ! findTenant; then
        log "\\n--------------------------------------------------------------------------------\\n"

        log "There is no active tenant yet. Skip cron jobs and backups."
        status=0
    fi

    if [[ "$status" = 1 ]]; then
        log "\\n--------------------------------------------------------------------------------\\n"

        if askYesNo "Do you want to configure i-doit cron jobs?"; then
            deployScriptSettings
            deployConsole
            deployJobScript
            deployCronJobs

            log "Cron jobs are successfully activated. To change e-mail address, execution date and time please edit this file:"
            log ""
            log "    $CRON_FILE"
            log ""
            log "There is also a script available for root to execute the i-doit console command line tool:"
            log ""
            log "    idoit"
            log ""
            log "The needed cron jobs are defined here:"
            log ""
            log "    $JOBS_BIN"
            log ""
            log "If needed you can change the settings of both the i-doit console and the cron jobs:"
            log ""
            log "    $SCRIPT_SETTINGS"

            status=2
        fi
    fi

    if [[ "$status" = 2 ]]; then
        log "\\n--------------------------------------------------------------------------------\\n"

        if askYesNo "Do you want to backup i-doit automatically?"; then
            deployBackupAndRestore

            log "Backups are successfully activated. Each night a backup will be created."
            log "Backups will be kept for 30 days:"
            log ""
            log "    $BACKUP_DIR"
            log ""
            log "You may create a backup manually:"
            log ""
            log "    idoit-backup"
            log ""
            log "Of course, you are able to restore i-doit from the latest backup:"
            log ""
            log "    idoit-restore"
            log ""
            log "Settings may be changed here:"
            log ""
            log "    $SCRIPT_SETTINGS"
        fi
    fi

    if [[ -f "$CREDENTIALS_FILE" ]]; then
        log "\\n--------------------------------------------------------------------------------\\n"

        log "All passwords are stored in this file which only root may read:"
        log ""
        log "    $CREDENTIALS_FILE"
    fi

    log "\\n--------------------------------------------------------------------------------\\n"
}

function identifyOS {
    if [[ ! -f "/etc/os-release" ]]; then
        log "File /etc/os-release is missing"
        abort "Unable to identify operating system"
    fi

    # shellcheck source=/dev/null
    source "/etc/os-release"

    log "Operating system identified as ${PRETTY_NAME}"

    case "${ID:-}:${VERSION_ID:-}" in
    debian:13)
        export DEBIAN_FRONTEND="noninteractive"
        OS="debian13"
        APACHE_USER="www-data"
        APACHE_GROUP="www-data"
        APACHE_CONFIG_FILE="/etc/apache2/sites-available/i-doit.conf"
        APACHE_SSL_CONFIG_FILE="/etc/apache2/sites-available/i-doit-ssl.conf"
        MARIADB_CONFIG_FILE="/etc/mysql/mariadb.conf.d/99-i-doit.cnf"
        PHP_CONFIG_FILE="/etc/php/8.4/mods-available/i-doit.ini"
        MARIADB_SOCKET="/var/run/mysqld/mysqld.sock"
        PHP_FPM_SOCKET="/var/run/php/php8.4-fpm.sock"
        APACHE_UNIT="apache2"
        MARIADB_UNIT="mysql"
        MEMCACHED_UNIT="memcached"
        PHP_FPM_UNIT="php8.4-fpm"
        CRON_UNIT="cron"
        ;;
    debian:12)
        abort "Debian 12 is not supported anymore. Please use Debian 13."
        ;;
    ubuntu:24.04)
        export DEBIAN_FRONTEND="noninteractive"
        OS="ubuntu2404"
        APACHE_USER="www-data"
        APACHE_GROUP="www-data"
        APACHE_CONFIG_FILE="/etc/apache2/sites-available/i-doit.conf"
        APACHE_SSL_CONFIG_FILE="/etc/apache2/sites-available/i-doit-ssl.conf"
        MARIADB_CONFIG_FILE="/etc/mysql/mariadb.conf.d/99-i-doit.cnf"
        PHP_CONFIG_FILE="/etc/php/8.3/mods-available/i-doit.ini"
        MARIADB_SOCKET="/var/run/mysqld/mysqld.sock"
        PHP_FPM_SOCKET="/var/run/php/php8.3-fpm.sock"
        APACHE_UNIT="apache2"
        MARIADB_UNIT="mysql"
        MEMCACHED_UNIT="memcached"
        PHP_FPM_UNIT="php8.3-fpm"
        CRON_UNIT="cron"
        ;;
    rhel:9.* | rhel:10.* | rocky:10.*)
        case "${PLATFORM_ID:-}" in
        "platform:el9")
            OS="el9"
            ;;
        "platform:el10")
            OS="el10"
            ;;
        *)
            abort "Unable to identify platform of ${PRETTY_NAME}"
            ;;
        esac

        APACHE_USER="apache"
        APACHE_GROUP="apache"
        APACHE_CONFIG_FILE="/etc/httpd/conf.d/i-doit.conf"
        APACHE_SSL_CONFIG_FILE="/etc/httpd/conf.d/i-doit-ssl.conf"
        MARIADB_CONFIG_FILE="/etc/my.cnf.d/99-i-doit.cnf"
        PHP_CONFIG_FILE="/etc/php.d/i-doit.ini"
        MARIADB_SOCKET="/var/lib/mysql/mysql.sock"
        PHP_FPM_SOCKET="/var/run/php-fpm/php-fpm.sock"
        APACHE_UNIT="httpd"
        MARIADB_UNIT="mariadb"
        MEMCACHED_UNIT="memcached"
        PHP_FPM_UNIT="php-fpm"
        CRON_UNIT="crond"
        ;;
    sles:15.6)
        OS="sles15"
        : "${INSTALL_DIR:="/srv/www/htdocs"}"
        APACHE_USER="wwwrun"
        APACHE_GROUP="www"
        APACHE_CONFIG_FILE="/etc/apache2/vhosts.d/i-doit.conf"
        APACHE_SSL_CONFIG_FILE="/etc/apache2/vhosts.d/i-doit-ssl.conf"
        MARIADB_CONFIG_FILE="/etc/my.cnf.d/99-i-doit.cnf"
        PHP_CONFIG_FILE="/etc/php8/conf.d/i-doit.ini"
        MARIADB_SOCKET="/var/run/mysql/mysql.sock"
        PHP_FPM_SOCKET="/var/run/php-fpm/php8-fpm.sock"
        APACHE_UNIT="apache2"
        MARIADB_UNIT="mariadb"
        MEMCACHED_UNIT="memcached"
        PHP_FPM_UNIT="php-fpm"
        CRON_UNIT="cron"
        ;;
    *)
        log "Supported operating systems:"
        log "    Debian GNU/Linux 13"
        log "    Ubuntu 24.04 LTS"
        log "    Red Hat Enterprise Linux 9 and 10"
        log "    Rocky Linux 10"
        log "    SUSE Linux Enterprise Server 15 SP6"
        abort "Operating system ${PRETTY_NAME} is not supported"
        ;;
    esac

    : "${INSTALL_DIR:="/var/www/html"}"
}

## A fresh Web server only comes with its welcome page:
function isInstallDirEmpty {
    [[ ! -d "$INSTALL_DIR" ||
        -z "$(find "$INSTALL_DIR" -mindepth 1 -maxdepth 1 ! -name index.html -print -quit)" ]]
}

## Stop before the first change of the system if i-doit is already installed:
function checkExistingInstallation {
    local found=0
    local databases=""

    if ! isInstallDirEmpty; then
        log "Directory '${INSTALL_DIR}' is not empty."
        found=1
    fi

    if [[ -x "$(command -v mysql)" ]]; then
        if ! databases=$(mysql --batch --skip-column-names -e"SHOW DATABASES LIKE 'idoit\\_system'" 2>/dev/null); then
            ## Without a running server there is no database to overwrite:
            if [[ -S "$MARIADB_SOCKET" ]] || systemctl -q is-active "${MARIADB_UNIT}.service"; then
                abort "MariaDB is running, but root is unable to log in via unix socket. Unable to check for an existing i-doit installation."
            fi

            databases=""
        fi

        if [[ -n "$databases" ]]; then
            log "MariaDB database 'idoit_system' already exists."
            found=1
        fi
    fi

    if [[ "$found" = 0 ]]; then
        return 0
    fi

    log "This script only supports a fresh installation. It would overwrite the existing configuration"
    log "and remove all files in '${INSTALL_DIR}'."

    if isUnattended; then
        abort "Refuse to change an existing installation"
    fi

    if askNoYes "Do you really want to continue?"; then
        cancel
    fi

    INSTALL_DIR_CONFIRMED=1
}

function checkHardwareRequirements {
    local cores=0
    local ram=0
    local arch=""

    log "Check hardware requirements…"

    arch=$(uname -m)

    if [[ "$arch" != "x86_64" ]]; then
        log "Attention! The system architecture is not x86 64 bit, but ${arch}. This could cause unwanted behaviour."

        if askNoYes "Do you really want to continue?"; then
            cancel
        fi
    fi

    cores=$(nproc)

    if [[ "$cores" -ge "$MIN_CPU_CORES" ]]; then
        log "$cores CPU cores detected; $MIN_CPU_CORES is required minimum"
    else
        log "Less than $MIN_CPU_CORES CPU cores detected"
        log "Found only $cores CPU core(s)."
        log "Your system does not meet the requirements. See:"
        log ""
        log "    <https://kb.i-doit.com/en/installation/system-requirements.html>"
        log ""
        if askNoYes "Do you really want to continue?"; then
            cancel
        fi
    fi

    ram=$(vmstat --stats --unit b | grep -i "total memory" | awk '{print $1}')

    if [[ "$ram" -ge "$MIN_RAM" ]]; then
        log "$ram bytes of total memory detected; $MIN_RAM is required minimum"
    else
        log "Less than $MIN_RAM bytes of total memory detected"
        log "Found only $ram bytes."
        log "Your system does not meet the requirements. See:"
        log ""
        log "    <https://kb.i-doit.com/en/installation/system-requirements.html>"
        log ""
        if askNoYes "Do you really want to continue?"; then
            cancel
        fi
    fi
}

function checkSoftwareRequirements {
    local failed=0
    local phpModules=""

    log "Check for installed applications and services…"

    MARIADB_BIN=$(command -v mysql || true)
    SUDO_BIN=$(command -v sudo || true)
    UNZIP_BIN=$(command -v unzip || true)
    WGET_BIN=$(command -v wget || true)
    PHP_BIN=$(command -v php || true)

    declare -A binaries
    binaries["mariadb"]="$MARIADB_BIN"
    binaries["sudo"]="$SUDO_BIN"
    binaries["unzip"]="$UNZIP_BIN"
    binaries["wget"]="$WGET_BIN"
    binaries["php"]="$PHP_BIN"
    binaries["systemctl"]=$(command -v systemctl || true)
    binaries["chronic"]=$(command -v chronic || true)
    binaries["memcached"]=$(command -v memcached || true)
    binaries["openssl"]=$(command -v openssl || true)

    case "$OS" in
    "el9" | "el10")
        binaries["httpd"]=$(command -v httpd || true)
        binaries["crond"]=$(command -v crond || true)
        ;;
    *)
        binaries["apachectl"]=$(command -v apachectl || true)
        binaries["cron"]=$(command -v cron || true)
        ;;
    esac

    for bin in "${!binaries[@]}"; do
        if [[ -x "${binaries[$bin]}" ]]; then
            log "$bin: found"
        else
            log "$bin: missing"
            failed=$((failed + 1))
        fi
    done

    if [[ -x "$PHP_BIN" ]]; then
        log "Check for installed PHP extensions…"

        case "$OS" in
        ## EPEL has no imagick and memcached for the PHP 8.3 module on EL 9:
        "el9")
            local phpExtensions=(bcmath ctype curl fileinfo gd json ldap
                mbstring mysqli mysqlnd pgsql session soap xml xmlwriter zip)
            ;;
        *)
            local phpExtensions=(bcmath ctype curl fileinfo gd imagick json ldap
                mbstring memcached mysqli mysqlnd pgsql session soap xml xmlwriter zip)
            ;;
        esac

        phpModules=$("$PHP_BIN" -m) || abort "Unable to list PHP extensions"

        for phpExtension in "${phpExtensions[@]}"; do
            if grep -qix "$phpExtension" <<<"$phpModules"; then
                log "PHP extension $phpExtension: found"
            else
                log "PHP extension $phpExtension: missing"
                failed=$((failed + 1))
            fi
        done
    fi

    case "$failed" in
    0)
        log "All software requirements met. Excellent."
        ;;
    1)
        abort "Important software requirement is missing. Please install and configure it."
        ;;
    *)
        abort "Important software requirements are missing. Please install and configure them."
        ;;
    esac
}

function configureOS {
    case "$OS" in
    "debian13")
        configureDebian13
        ;;
    "ubuntu2404")
        configureUbuntu2404
        ;;
    "el9" | "el10")
        configureEL
        ;;
    "sles15")
        configureSLES15
        ;;
    *)
        abort "Unknown operating system '${OS}'!?!"
        ;;
    esac
}

# Debian13
function configureDebian13 {
    log "Keep your Debian packages up-to-date"
    apt-get -qq --yes update || abort "Unable to update Debian package repositories"
    apt-get -qq --yes full-upgrade || abort "Unable to perform update of Debian packages"
    apt-get -qq --yes clean || abort "Unable to cleanup Debian packages"
    apt-get -qq --yes autoremove || abort "Unable to remove unnecessary Debian packages"

    log "Install required Debian 13 packages"
    apt-get -qq --yes install --no-install-recommends \
        apache2 libapache2-mod-fcgid \
        mariadb-client mariadb-server \
        php-bcmath php-cli php-common php-curl php-fpm php-gd \
        php-ldap php-mbstring php-mysql php-opcache php-pgsql \
        php-soap php-xml php-zip \
        php-imagick php-memcached \
        memcached unzip sudo wget moreutils openssl cron ca-certificates ||
            abort "Unable to install required Debian packages"

    unitctl "enable" "$CRON_UNIT"
    unitctl "start" "$CRON_UNIT"

    openHTTPPort
}

