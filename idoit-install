        abort "MARIADB_IDOIT_PASSWORD must not contain any of these characters: $(listChars "$MARIADB_IDOIT_PASSWORD_FORBIDDEN_CHARS")"
    fi
}

## Stop before the first change of the system if the preset password cannot work:
function checkIDoitAdminPassword {
    if containsAnyChar "$IDOIT_ADMIN_PASSWORD" "$IDOIT_ADMIN_PASSWORD_FORBIDDEN_CHARS"; then
        abort "IDOIT_ADMIN_PASSWORD must not contain any of these characters: $(listChars "$IDOIT_ADMIN_PASSWORD_FORBIDDEN_CHARS")"
