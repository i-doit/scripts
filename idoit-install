function configureEL {
    local major="${VERSION_ID%%.*}"
    local phpPackages=(php php-fpm php-bcmath php-cli php-common php-curl php-gd php-json
        php-ldap php-mbstring php-mysqlnd php-opcache php-pdo php-pgsql php-process
        php-soap php-xml php-zip)

    if [[ "$ID" = "rhel" ]] && ! hasRHELBaseRepositories; then
        enableRHELBaseRepositories
    fi

    log "Keep your packages up-to-date"
    dnf --assumeyes --quiet update || abort "Unable to update software packages"

    log "Install dnf-plugins-core"
    dnf --assumeyes --quiet install dnf-plugins-core || abort "Unable to install dnf-plugins-core"

    ## EPEL provides moreutils (chronic is needed for idoit-jobs) and PHP extensions:
    case "$ID" in
    "rhel")
        log "Install EPEL ${major} repository"
        dnf --assumeyes --quiet install \
            "https://dl.fedoraproject.org/pub/epel/epel-release-latest-${major}.noarch.rpm" ||
            abort "Unable to install EPEL repository"

        ## Provides dependencies for EPEL packages:
        log "Enable CodeReady Linux Builder repository"
        subscription-manager repos --enable "codeready-builder-for-rhel-${major}-$(arch)-rpms" ||
            abort "Unable to enable CodeReady Linux Builder repository"
        ;;
    *)
        log "Install EPEL ${major} repository"
        dnf --assumeyes --quiet install epel-release || abort "Unable to install EPEL repository"

        ## Provides dependencies for EPEL packages:
        log "Enable CRB repository"
        dnf config-manager --set-enabled crb || abort "Unable to enable CRB repository"
        ;;
    esac

    case "$OS" in
    "el9")
        for appStream in mariadb:10.11 php:8.3; do
            log "Enable AppStream module $appStream"
            dnf --assumeyes --quiet module enable "$appStream" || abort "Unable to enable AppStream module $appStream"
        done
        ;;
    "el10")
        ## EPEL packages are built against the default PHP version,
        ## which is not the case for the PHP 8.3 module on EL 9:
        phpPackages+=(php-pecl-imagick php-pecl-memcached)
        ;;
    esac

    log "Install some important packages"
    dnf --assumeyes --quiet install \
        httpd mariadb mariadb-server memcached unzip sudo wget zip moreutils openssl \
        cronie ca-certificates policycoreutils-python-utils \
        "${phpPackages[@]}" || abort "Unable to install packages"

    for unit in $APACHE_UNIT $MARIADB_UNIT $MEMCACHED_UNIT $PHP_FPM_UNIT $CRON_UNIT; do
        unitctl "enable" "$unit"
        unitctl "start" "$unit"
    done

    if ! systemctl -q is-active firewalld.service; then
        log "firewalld is not active. Please make sure that TCP port 80 (HTTP) is open."
    else
        log "Allow incoming HTTP traffic"
        firewall-cmd --permanent --add-service=http || abort "Unable to configure firewall"
        firewall-cmd --reload || abort "Unable to reload firewall"
    fi
}

## Registering RHEL 10 may disable repository management of subscription-manager
## (manage_repos = 0 in /etc/rhsm/rhsm.conf), so a registered system has no enabled repositories:
function hasRHELBaseRepositories {
    local repos=""

    repos=$(dnf --quiet repolist --enabled 2>/dev/null) || return 1

    grep -qi "baseos" <<<"$repos" && grep -qi "appstream" <<<"$repos"
}

function isRHELRegistered {
    [[ -x "$(command -v subscription-manager)" ]] &&
        subscription-manager identity >/dev/null 2>&1
}

## Stop before the first change of the system if RHEL cannot install any packages:
function checkRHELRepositories {
    if [[ "$ID" != "rhel" ]] || hasRHELBaseRepositories || isRHELRegistered; then
        return 0
    fi

    abort "The BaseOS and AppStream repositories are not enabled and this system is not registered.\nPlease register it first, for example with 'subscription-manager register'."
}

function enableRHELBaseRepositories {
    local major="${VERSION_ID%%.*}"
    local arch=""
    local baseos=""
    local appstream=""

    arch=$(arch) || abort "Unable to identify the architecture"
    baseos="rhel-${major}-for-${arch}-baseos-rpms"
    appstream="rhel-${major}-for-${arch}-appstream-rpms"

    log "The BaseOS and AppStream repositories are not enabled"

    log "Enable repository management of subscription-manager"
    subscription-manager config --rhsm.manage_repos=1 ||
        abort "Unable to enable repository management of subscription-manager"
    subscription-manager refresh || abort "Unable to refresh subscription data"

    log "Enable repositories ${baseos} and ${appstream}"
    subscription-manager repos --enable "$baseos" --enable "$appstream" ||
        abort "Unable to enable repositories ${baseos} and ${appstream}"
}

