function isValidMailto {
    [[ "$1" =~ ^[A-Za-z0-9._%+@-]+$ ]]
}

## Stop before the first change of the system if the preset address cannot work:
function checkCronMailto {
    isValidMailto "$CRON_MAILTO" || abort "Invalid e-mail address '${CRON_MAILTO}'. Please set CRON_MAILTO."
}

function deployCronJobs {
    local file="$TMP_DIR/cron"
    local mailto=""

    fetchFile cron "$file"

    while true; do
        echo -n -e "Please enter an e-mail address for errors of cron jobs [leave empty for '${CRON_MAILTO}']: "
        readAnswer

        mailto="${answer:-$CRON_MAILTO}"

        if isValidMailto "$mailto"; then
            CRON_MAILTO="$mailto"
            break
        fi

        if isUnattended; then
            abort "Invalid e-mail address '${mailto}'. Please set CRON_MAILTO."
        fi

        log "Invalid e-mail address '${mailto}'. Please try again."
    done

    sed -i -- "s/^MAILTO=.*/MAILTO=\"${CRON_MAILTO}\"/" "$file" || abort "Unable to set e-mail address"

    chmod 644 "$file" || abort "Unable to set read/write bits"

    mv "$file" "$CRON_FILE" || abort "Unable to move file to '/etc/cron.d/i-doit'"
}

function deployBackupAndRestore {
    log "Deploy backup and restore scripts"

    deployScript idoit-backup
    deployScript idoit-restore

    log "Create the first backup"
