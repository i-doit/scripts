function configureProxy {
    if [[ -n "${https_proxy+x}" ]]; then
        log "Found proxy settings in environment variable 'https_proxy': $(maskProxy "$https_proxy")"

        if askYesNo "Do you want to use this setting?"; then
            ## Package mirrors via plain HTTP only use http_proxy:
            if [[ -z "${http_proxy:-}" ]]; then
                log "Use the same proxy for HTTP (environment variable 'http_proxy')"
                export http_proxy="$https_proxy"
            fi

            return 0
        fi
    fi

    echo -n -e "Provide proxy settings [schema: https://username:password@proxy:port]: "

    readAnswer

    if [[ -n "$answer" ]]; then
        log "Set environment variable 'https_proxy' to '$(maskProxy "$answer")'"
        export https_proxy="$answer"
        log "Use the same proxy for HTTP (environment variable 'http_proxy')"
        export http_proxy="$answer"
    else
        log "No settings found. Skip it."
    fi
}

## Hide username and password of a proxy URL:
function maskProxy {
    if [[ "$1" =~ ^([^/]*//)[^/@]*@(.*)$ ]]; then
        echo "${BASH_REMATCH[1]}***@${BASH_REMATCH[2]}"
    else
        echo "$1"
    fi
}

