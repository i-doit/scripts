function deployScript {
    local file="$1"
    local tmp_file="${TMP_DIR}/$file"

    log "Deploy script '$file'"

    fetchFile "$file" "$tmp_file"

    chmod 775 "$tmp_file" || abort "Unable to set read/write/executable bits"

    mv "$tmp_file" "/usr/local/bin/$file" || abort "Unable to move file to '/usr/local/bin/'"
}

## Take a file of this repository from the directory of this script or download it from GitHub:
function fetchFile {
    local name="$1"
    local target="$2"
    local local_file=""
    local url=""

    if local_file=$(localHelperFile "$name"); then
        log "Use local file '${local_file}'"
        cp "$local_file" "$target" || abort "Unable to copy file '${local_file}'"
    else
        url=$(helperFileURL "$name")
        log "Download file from '${url}'"
        "$WGET_BIN" --quiet -O "$target" "$url" || abort "$(helperFileError "$url")"
    fi

    test -s "$target" || abort "File '${name}' is empty"
}

## Print the path of the local copy of a helper file next to this script:
function localHelperFile {
    local name="$1"

    ## Other users must not be able to replace local files:
    if [[ -n "$SCRIPT_DIR" && -f "${SCRIPT_DIR}/${name}" &&
        -z "$(find "$SCRIPT_DIR" "${SCRIPT_DIR}/${name}" -maxdepth 0 -perm -0002)" ]]; then
        echo "${SCRIPT_DIR}/${name}"
        return 0
    fi

    return 1
}

function helperFileURL {
    echo "https://raw.githubusercontent.com/i-doit/scripts/${SCRIPTS_REF:-$PROJECT_VERSION}/${1}"
}

function helperFileError {
    echo "Unable to fetch file from '${1}'. Does the Git ref '${SCRIPTS_REF:-$PROJECT_VERSION}' exist? Set SCRIPTS_REF, for example SCRIPTS_REF=main."
}

## Stop before changing the system if helper files are neither local nor downloadable.
## Before the packages are installed (argument "early") only a missing file stops the script;
## without wget, curl or CA certificates the check runs again after the installation of packages:
function checkHelperFiles {
    local phase="${1:-}"
    local name=""
    local url=""
    local status=0
    local missing=()

    if [[ "$HELPER_FILES_CHECKED" = 1 ]]; then
        return 0
    fi

    for name in "${HELPER_FILES[@]}"; do
        if ! localHelperFile "$name" >/dev/null; then
            missing+=("$name")
        fi
    done

    if [[ "${#missing[@]}" -gt 0 && ! -x "$(command -v wget)" && ! -x "$(command -v curl)" ]]; then
        log "Neither wget nor curl found. Check helper files after the installation of packages."
        return 0
    fi

    for name in "${missing[@]}"; do
        url=$(helperFileURL "$name")
        log "Check file '${url}'"
        status=0

        ## Exit code for an HTTP error such as 404: 8 (wget), 22 (curl):
        if [[ -x "$(command -v wget)" ]]; then
            wget --quiet --spider "$url" || status=$?
            [[ "$status" = 8 ]] && abort "$(helperFileError "$url")"
        else
            curl --silent --fail --location --head --output /dev/null "$url" || status=$?
            [[ "$status" = 22 ]] && abort "$(helperFileError "$url")"
        fi

        if [[ "$status" != 0 ]]; then
            if [[ "$phase" = "early" ]]; then
                log "Unable to reach '${url}' yet. Check helper files after the installation of packages."
                return 0
            fi

            abort "$(helperFileError "$url")"
        fi
    done

    log "All helper files are available."
    HELPER_FILES_CHECKED=1
}

## Print the IP address of the default route, or the first address without a default route:
function primaryIP {
    local ip_address=""

    if [[ -x "$(command -v ip)" ]]; then
        ip_address=$(ip route get 1 2>/dev/null | sed -n 's/^.*src \([^ ]*\).*$/\1/p' | head -n 1 || true)
    fi

    if [[ -z "$ip_address" ]]; then
        ip_address=$(hostname -I 2>/dev/null | awk '{print $1}' || true)
    fi

    echo "$ip_address"
}

function isSELinuxEnabled {
    [[ -x "$(command -v getenforce)" && "$(getenforce)" != "Disabled" ]]
}

function unitctl {
    local action="$1"
    local unit="$2"

    log "${action^} $unit"

    systemctl -q "$action" "${unit}.service" || abort "Failed to $action $unit"
}

function setup {
    # We need English to check some command outputs:
    if locale -a | grep "^en_US.utf8" >/dev/null; then
        export LC_ALL="en_US.utf8"
        export LANG="en_US.utf8"
        export LANGUAGE="en_US.utf8"
    elif locale -a | grep "^en_GB.utf8" >/dev/null; then
        export LC_ALL="en_GB.utf8"
        export LANG="en_GB.utf8"
        export LANGUAGE="en_GB.utf8"
    elif locale -a | grep "^C.UTF-8" >/dev/null; then
        export LC_ALL="C.UTF-8"
        export LANG="C.UTF-8"
        export LANGUAGE="C.UTF-8"
    elif locale -a | grep "^C.utf8" >/dev/null; then
        export LC_ALL="C.utf8"
        export LANG="C.utf8"
        export LANGUAGE="C.utf8"
    else
        log "This script may fail because it depends on US/GB English locale. We try it anyway…"
    fi

    test "$(whoami)" = "root" || abort "Superuser rights required"

    TMP_DIR=$(mktemp -d /tmp/i-doit.XXXXXX) || abort "Unable to create temporary directory"
}

## Commands needed before the script installs any packages:
function checkRequiredCommands {
    local cmd=""
    local missing_commands=""

    for cmd in awk find getopt grep locale mktemp nproc sed vmstat; do
        if [[ ! -x "$(command -v "$cmd")" ]]; then
            missing_commands="${missing_commands} ${cmd}"
        fi
    done

    if [[ -n "$missing_commands" ]]; then
        abort "Missing commands:${missing_commands}\nPlease install them, for example getopt with package util-linux and vmstat with package procps (procps-ng on RHEL and Rocky Linux)."
    fi
}

function tearDown {
    if [[ -n "$TMP_DIR" && -d "$TMP_DIR" ]]; then
        rm -rf "$TMP_DIR" || echo "Failed to cleanup" 1>&2
    fi
}

function showUsage {
    log "Usage: $BASENAME [OPTIONS]"
    log ""
    log "Options:"
    log ""
    log "    -h, --help      Print usage"
    log "    -v, --version   Print version"
}

function printVersion {
    log "$PROJECT_VERSION"
}

function log {
    echo -e "$1"
}

function isUnattended {
    [[ "$IDOIT_UNATTENDED" = "1" || ! -t 0 ]]
}

## Read a line into the global variable "answer"; stays empty in unattended mode:
function readAnswer {
    answer=""

    if isUnattended; then
        echo ""
        return 0
    fi

    read -r answer
}

function askYesNo {
    echo -n -e "$1 [Y]es [n]o: "

    if isUnattended; then
        echo "yes"
        return 0
    fi

    read -r answer

    case "$answer" in
    "" | "Y" | "Yes" | "y" | "yes")
        return 0
        ;;
    "No" | "no" | "n" | "N")
        return 1
        ;;
    *)
        log "Sorry, what do you mean?"
        askYesNo "$1"
        ;;
    esac
}

function askNoYes {
    echo -n -e "$1 [y]es [N]o: "

    if isUnattended; then
        echo "no"
        return 0
    fi

    read -r answer

    case "$answer" in
    "" | "No" | "no" | "n" | "N")
        return 0
        ;;
    "Y" | "Yes" | "y" | "yes")
        return 1
        ;;
    *)
        log "Sorry, what do you mean?"
        askNoYes "$1"
        ;;
    esac
}

function finish {
    log "Done. Have fun :-)"
    exit 0
}

function abort {
    echo -e "$1" 1>&2
    echo "Operation failed. Please check what is wrong and try again." 1>&2
    exit 1
}

## Stop on request of the user; without a user a default answer stopped the run, which is an error:
function cancel {
    if isUnattended; then
        abort "Stopped in unattended mode"
    fi

    echo "Bye"
    exit 0
}

