}

function checkHTTPSSettings {
    local setting=""

    for setting in IDOIT_HTTPS_REDIRECT IDOIT_HSTS; do
        case "${!setting,,}" in
        "yes" | "no") ;;
        *)
            abort "${setting} must be 'yes' or 'no'"
            ;;
        esac
    done
}

function isValidHostname {
    [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]]
}

## Ask for the host name in the certificate before the first change of the system:
function askFQDN {
    local fqdn=""

    if [[ -z "$IDOIT_FQDN" ]]; then
        IDOIT_FQDN="$(hostname -f 2>/dev/null || cat /etc/hostname 2>/dev/null || true)"
    fi

    while true; do
        echo -n -e "Please enter the host name used in the certificate [leave empty for '${IDOIT_FQDN}']: "

        readAnswer

        fqdn="${answer:-$IDOIT_FQDN}"

        if isValidHostname "$fqdn"; then
            IDOIT_FQDN="$fqdn"
            break
        fi

        if isUnattended; then
            abort "Invalid host name '${fqdn}'. Please set IDOIT_FQDN."
        fi

        log "Invalid host name '${fqdn}'. Please try again."
    done

    if [[ "$IDOIT_FQDN" != *.* ]]; then
        log "Attention! The host name '${IDOIT_FQDN}' is not fully qualified. Clients may not resolve it."
        log "Set IDOIT_FQDN to the fully qualified host name if needed."
    fi
}

function configureHTTPS {
    local cert_file="${TLS_DIR}/i-doit.crt"
    local key_file="${TLS_DIR}/i-doit.key"

    log "Configure HTTPS"

    if [[ "$IDOIT_HTTPS_MODE" = "none" ]]; then
        log "Skip HTTPS"
        return 0
    fi

    checkHTTPSSettings

    isValidHostname "$IDOIT_FQDN" || abort "Invalid host name '${IDOIT_FQDN}'. Please set IDOIT_FQDN."

    enableApacheSSL

    case "$IDOIT_HTTPS_MODE" in
    "selfsigned")
        createSelfSignedCertificate "$cert_file" "$key_file"
        ;;
    "custom")
        installCustomCertificate "$cert_file" "$key_file"
        ;;
    esac

    if isSELinuxEnabled; then
        log "SELinux: Label certificates under ${TLS_DIR}/"
        semanage fcontext -a -t cert_t "${TLS_DIR}(/.*)?" 2>/dev/null ||
            semanage fcontext -m -t cert_t "${TLS_DIR}(/.*)?" ||
            abort "Unable to define SELinux file context for '${TLS_DIR}'"
        restorecon -R "${TLS_DIR}/" || abort "Unable to restore SELinux file context for '${TLS_DIR}'"
    fi

    writeSSLVHost "$cert_file" "$key_file"

    if [[ "${IDOIT_HTTPS_REDIRECT,,}" = "yes" ]]; then
        redirectToHTTPS
    fi

    openHTTPSPort

    unitctl "restart" "$APACHE_UNIT"

    HTTPS_URL="https://${IDOIT_FQDN}/"

    log "HTTPS is available at ${HTTPS_URL}"
}

function enableApacheSSL {
    case "$OS" in
    "el9" | "el10")
        log "Install Apache module mod_ssl"
        dnf --assumeyes --quiet install mod_ssl || abort "Unable to install mod_ssl"
        ;;
    "debian13" | "ubuntu2404" | "sles15")
        log "Enable Apache module ssl"
        a2enmod ssl || abort "Unable to enable Apache module ssl"

        if [[ "$OS" = "sles15" ]]; then
            log "Enable Apache module socache_shmcb"
            a2enmod socache_shmcb || abort "Unable to enable Apache module socache_shmcb"
            ## Makes Apache listen on port 443:
            log "Enable Apache flag SSL"
            a2enflag SSL || abort "Unable to enable Apache flag SSL"
        fi

        if [[ "${IDOIT_HSTS,,}" = "yes" ]]; then
            log "Enable Apache module headers"
            a2enmod headers || abort "Unable to enable Apache module headers"
        fi
        ;;
    esac
}

function createSelfSignedCertificate {
    local cert_file="$1"
    local key_file="$2"
    local ip_address=""
    local san="DNS:${IDOIT_FQDN}"
    local cert_public_key=""
    local key_public_key=""

    ## Keep a certificate from a previous run or an own one unless it is expired or broken:
    if [[ -f "$cert_file" && -f "$key_file" ]] &&
        openssl x509 -checkend 0 -noout -in "$cert_file" >/dev/null 2>&1; then
        cert_public_key="$(openssl x509 -noout -pubkey -in "$cert_file" 2>/dev/null || true)"
        key_public_key="$(openssl pkey -pubout -passin pass: -in "$key_file" 2>/dev/null || true)"

        if [[ -n "$cert_public_key" && "$cert_public_key" = "$key_public_key" ]]; then
            log "Keep existing certificate '${cert_file}'. Remove it to create a new one."
            return 0
        fi
    fi

    install -d -m 0700 "$TLS_DIR" || abort "Unable to create directory '${TLS_DIR}'"

    if [[ "$IDOIT_FQDN" =~ ^[0-9.]+$ ]]; then
        san="IP:${IDOIT_FQDN}"
    fi

    ## Clients may also reach i-doit by its IP address:
    ip_address=$(primaryIP)

    if [[ "$ip_address" =~ ^[0-9A-Fa-f:.]+$ && "$ip_address" != "$IDOIT_FQDN" ]]; then
        san="${san},IP:${ip_address}"
    fi

    log "Create self-signed certificate for ${san}"
    (umask 077 && openssl req -x509 -newkey rsa:3072 -days 825 -nodes \
        -subj "/CN=${IDOIT_FQDN}" -addext "subjectAltName=${san}" \
        -addext "basicConstraints=critical,CA:FALSE" \
        -addext "keyUsage=critical,digitalSignature,keyEncipherment" \
        -addext "extendedKeyUsage=serverAuth" \
        -keyout "$key_file" -out "$cert_file") || abort "Unable to create self-signed certificate"

    chmod 0644 "$cert_file" || abort "Unable to change permissions of '${cert_file}'"
}

## Ask for the own certificate before the first change of the system:
function askCustomCertificate {
    while true; do
        if [[ -z "$IDOIT_TLS_CERT" ]]; then
            echo -n -e "Please enter the path to your certificate (PEM): "
            readAnswer
            IDOIT_TLS_CERT="$answer"
        fi

        if [[ -z "$IDOIT_TLS_KEY" ]]; then
            echo -n -e "Please enter the path to your private key (PEM, not encrypted): "
            readAnswer
            IDOIT_TLS_KEY="$answer"
        fi

        if [[ -z "$IDOIT_TLS_CHAIN" ]]; then
            echo -n -e "Please enter the path to your intermediate certificates (PEM) [leave empty for none]: "
            readAnswer
            IDOIT_TLS_CHAIN="$answer"
        fi

        if testCustomCertificate; then
            return 0
        fi

        if isUnattended; then
            abort "$CERTIFICATE_ERROR"
        fi

        log "$CERTIFICATE_ERROR"
        log "Please try again."

        IDOIT_TLS_CERT=""
        IDOIT_TLS_KEY=""
        IDOIT_TLS_CHAIN=""
    done
}

function checkCustomCertificate {
    testCustomCertificate || abort "$CERTIFICATE_ERROR"
}

## Check the own certificate without stopping; the reason of a failure is in CERTIFICATE_ERROR:
function testCustomCertificate {
    local cert_public_key=""
    local key_public_key=""

    CERTIFICATE_ERROR=""

    if [[ -z "$IDOIT_TLS_CERT" || -z "$IDOIT_TLS_KEY" ]]; then
        CERTIFICATE_ERROR="Certificate and private key are required. Please set IDOIT_TLS_CERT and IDOIT_TLS_KEY."
        return 1
    fi

    log "Check certificate and private key"

    if [[ ! -r "$IDOIT_TLS_CERT" ]]; then
        CERTIFICATE_ERROR="Unable to read certificate '${IDOIT_TLS_CERT}'"
        return 1
    fi

    if [[ ! -r "$IDOIT_TLS_KEY" ]]; then
        CERTIFICATE_ERROR="Unable to read private key '${IDOIT_TLS_KEY}'"
        return 1
    fi

    if [[ -n "$IDOIT_TLS_CHAIN" && ! -r "$IDOIT_TLS_CHAIN" ]]; then
        CERTIFICATE_ERROR="Unable to read intermediate certificates '${IDOIT_TLS_CHAIN}'"
        return 1
    fi

    ## The operating system step installs openssl, so check the contents later:
    if [[ ! -x "$(command -v openssl)" ]]; then
        log "Command openssl not found, check the certificate after installing packages"
        return 0
    fi

    if ! openssl x509 -noout -in "$IDOIT_TLS_CERT"; then
        CERTIFICATE_ERROR="Invalid certificate '${IDOIT_TLS_CERT}'"
        return 1
    fi

    ## An empty pass phrase lets encrypted keys fail instead of asking for it:
    if ! openssl pkey -noout -passin pass: -in "$IDOIT_TLS_KEY"; then
        CERTIFICATE_ERROR="Invalid or encrypted private key '${IDOIT_TLS_KEY}'"
        return 1
    fi

    if [[ -n "$IDOIT_TLS_CHAIN" ]] && ! openssl x509 -noout -in "$IDOIT_TLS_CHAIN"; then
        CERTIFICATE_ERROR="Invalid intermediate certificates '${IDOIT_TLS_CHAIN}'"
        return 1
    fi

    if ! cert_public_key="$(openssl x509 -noout -pubkey -in "$IDOIT_TLS_CERT")"; then
        CERTIFICATE_ERROR="Unable to read public key from certificate"
        return 1
    fi

    if ! key_public_key="$(openssl pkey -pubout -passin pass: -in "$IDOIT_TLS_KEY")"; then
        CERTIFICATE_ERROR="Unable to read public key from private key"
        return 1
    fi

    if [[ "$cert_public_key" != "$key_public_key" ]]; then
        CERTIFICATE_ERROR="Private key '${IDOIT_TLS_KEY}' does not belong to certificate '${IDOIT_TLS_CERT}'"
        return 1
    fi
}

function installCustomCertificate {
    local cert_file="$1"
    local key_file="$2"

    ## The files may have changed since the first check:
    checkCustomCertificate

    install -d -m 0700 "$TLS_DIR" || abort "Unable to create directory '${TLS_DIR}'"

    log "Copy certificate and private key to ${TLS_DIR}/"

    install -m 0600 "$IDOIT_TLS_KEY" "$key_file" || abort "Unable to copy private key"

    ## Apache expects intermediate certificates after the server certificate:
    if [[ -n "$IDOIT_TLS_CHAIN" ]]; then
        { cat "$IDOIT_TLS_CERT" && echo "" && cat "$IDOIT_TLS_CHAIN"; } >"$cert_file" ||
            abort "Unable to copy certificate"
    else
        cat "$IDOIT_TLS_CERT" >"$cert_file" || abort "Unable to copy certificate"
    fi

    chmod 0644 "$cert_file" || abort "Unable to change permissions of '${cert_file}'"
}

function writeSSLVHost {
    local cert_file="$1"
    local key_file="$2"
    local hsts=""
    local log_dir="/var/log/apache2"

    if [[ "${IDOIT_HSTS,,}" = "yes" ]]; then
        hsts='Header always set Strict-Transport-Security "max-age=31536000"'
    fi

    log "Create HTTPS VHost ${APACHE_SSL_CONFIG_FILE}"

    case "$OS" in
    "el9" | "el10")
        ## Directory and PHP settings are global in ${APACHE_CONFIG_FILE}:
        cat <<EOF >"$APACHE_SSL_CONFIG_FILE" || abort "Unable to create and edit file '${APACHE_SSL_CONFIG_FILE}'"
<VirtualHost *:443>
    ServerName ${IDOIT_FQDN}

    SSLEngine on
    SSLCertificateFile ${cert_file}
    SSLCertificateKeyFile ${key_file}
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    SSLHonorCipherOrder off
    ${hsts}
</VirtualHost>
EOF

        ## Only the i-doit VHost shall answer on port 443:
        log "Disable default HTTPS VHost in /etc/httpd/conf.d/ssl.conf"
        sed -i '/^<VirtualHost _default_:443>/,/^<\/VirtualHost>/ s/^/#/' /etc/httpd/conf.d/ssl.conf ||
            abort "Unable to disable default HTTPS VHost"
        ;;
    "debian13" | "ubuntu2404" | "sles15")
        if [[ "$OS" != "sles15" ]]; then
            log_dir="\${APACHE_LOG_DIR}"
        fi

        cat <<EOF >"$APACHE_SSL_CONFIG_FILE" || abort "Unable to create and edit file '${APACHE_SSL_CONFIG_FILE}'"
<VirtualHost *:443>
    ServerName ${IDOIT_FQDN}
    ServerAdmin i-doit@example.net

    DirectoryIndex index.php
    DocumentRoot ${INSTALL_DIR}/

    <Directory ${INSTALL_DIR}/>
        AllowOverride None
        Require all granted

        ${APACHE_HTACCESS_SUBSTITUTION}
    </Directory>

    TimeOut 600
    ProxyTimeout 600

    <FilesMatch "\\.php$">
        <If "-f %{REQUEST_FILENAME}">
            SetHandler "proxy:unix:${PHP_FPM_SOCKET}|fcgi://localhost"
        </If>
    </FilesMatch>

    SSLEngine on
    SSLCertificateFile ${cert_file}
    SSLCertificateKeyFile ${key_file}
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    SSLHonorCipherOrder off
    ${hsts}

    LogLevel warn
    ErrorLog ${log_dir}/error.log
    CustomLog ${log_dir}/access.log combined
</VirtualHost>
EOF

        if [[ "$OS" != "sles15" ]]; then
            log "Enable HTTPS VHost"
            a2ensite i-doit-ssl || abort "Unable to enable HTTPS VHost"
        fi
        ;;
    esac
}

function redirectToHTTPS {
    local redirect_file="${TMP_DIR}/redirect.conf"

    if grep -q "RewriteRule ^ https://" "$APACHE_CONFIG_FILE"; then
        log "HTTP is already redirected to HTTPS"
        return 0
    fi

    log "Redirect HTTP to HTTPS"

    cat <<'EOF' >"$redirect_file" || abort "Unable to create file '${redirect_file}'"
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
EOF

    case "$OS" in
    "el9" | "el10")
        ## EL has no VHost for port 80, the main server handles HTTP:
        cat "$redirect_file" >>"$APACHE_CONFIG_FILE" || abort "Unable to edit file '${APACHE_CONFIG_FILE}'"
        ;;
    *)
        sed -i "/^<VirtualHost \*:80>/r ${redirect_file}" "$APACHE_CONFIG_FILE" ||
            abort "Unable to edit file '${APACHE_CONFIG_FILE}'"
        ;;
    esac
}

## Debian and Ubuntu: HTTP is needed in every HTTPS mode, EL and SLES open it on their own:
function openHTTPPort {
    if systemctl -q is-active firewalld.service; then
        log "Allow incoming HTTP traffic"
        firewall-cmd --permanent --add-service=http || abort "Unable to configure firewall"
        firewall-cmd --reload || abort "Unable to reload firewall"
    elif [[ -x "$(command -v ufw)" ]] && grep -q "^Status: active" < <(ufw status); then
        log "Allow incoming HTTP traffic"
        ufw allow 80/tcp || abort "Unable to configure firewall"
    else
        log "Please make sure that TCP port 80 (HTTP) is open."
    fi
}

function openHTTPSPort {
    if systemctl -q is-active firewalld.service; then
        log "Allow incoming HTTPS traffic"
        firewall-cmd --permanent --add-service=https || abort "Unable to configure firewall"
        firewall-cmd --reload || abort "Unable to reload firewall"
    elif [[ -x "$(command -v ufw)" ]] && grep -q "^Status: active" < <(ufw status); then
        log "Allow incoming HTTPS traffic"
        ufw allow 443/tcp || abort "Unable to configure firewall"
    else
        log "Please make sure that TCP port 443 (HTTPS) is open."
    fi
}

function isValidBufferPoolSize {
    [[ "$1" =~ ^[0-9]+[KMGkmg]?$ ]]
}

## Stop before the first change of the system if the preset size cannot work:
function checkBufferPoolSize {
    isValidBufferPoolSize "$MARIADB_INNODB_BUFFER_POOL_SIZE" ||
        abort "Invalid size '${MARIADB_INNODB_BUFFER_POOL_SIZE}'. Please set MARIADB_INNODB_BUFFER_POOL_SIZE, e.g. 1024M or 1G."
}

function configureMariaDB {
    local size=""

    log "Configure MariaDB DBMS"

    echo -e -n "Please enter the MariaDB hostname [leave empty for '${MARIADB_HOSTNAME}']: "
    readAnswer
    if [[ -n "$answer" ]]; then
        MARIADB_HOSTNAME="$answer"
    fi

    if [[ "$MARIADB_HOSTNAME" != "localhost" && "$MARIADB_HOSTNAME" != "127.0.0.1" ]] && isSELinuxEnabled; then
        log "SELinux: Allow Apache Web server to connect to a remote database"
        setsebool -P httpd_can_network_connect_db 1 || abort "Unable to set SELinux boolean httpd_can_network_connect_db"
    fi

    ## Check MariaDB version:
    local mariadb_version=""

    if [[ "$OS" == "debian13" ]]; then
        ## MariaDB 11.8 on Debian 13 prints "from 11.8.x-MariaDB" instead of "Distrib 11.8.x-MariaDB":
        mariadb_version=$(mysql --version | head -n1 | sed -e 's/.*from \([0-9]*\.[0-9]*\).*/\1/')
    else
        ## All other platforms print "Distrib x.y.z-MariaDB":
        mariadb_version=$(mysql --version | head -n1 | sed -e 's/.* Distrib \([0-9]*\.[0-9]*\).*/\1/')
    fi

    case "$mariadb_version" in
    "10.11" | "11.4" | "11.8")
        ;;
    *)
        abort "MariaDB ${mariadb_version} is not supported. Please follow the system requirements. We recommend version ${RECOMMENDED_MARIADB_VERSION}."
        ;;
    esac

    if ! isLocalMariaDB; then
        log "MariaDB runs on '${MARIADB_HOSTNAME}'. Skip settings of the local MariaDB server."
        requireMariaDBSuperuser
        return 0
    fi

    secureMariaDB

    log "How many bytes of your RAM do you like to spend to MariaDB?"

    while true; do
        echo -n -e "You SHOULD give MariaDB ~ 50 per cent of your RAM. You can use G for Gigabytes or M for Megabytes, e.g. 1024M or 1G [leave empty for '${MARIADB_INNODB_BUFFER_POOL_SIZE}']: "

        readAnswer

        size="${answer:-$MARIADB_INNODB_BUFFER_POOL_SIZE}"

        if isValidBufferPoolSize "$size"; then
            MARIADB_INNODB_BUFFER_POOL_SIZE="$size"
            break
        fi

        if isUnattended; then
            abort "Invalid size '${size}'. Please set MARIADB_INNODB_BUFFER_POOL_SIZE, e.g. 1024M or 1G."
        fi

        log "Invalid size '${size}'. Please try again."
    done

    log "Prepare shutdown of MariaDB"
    "$MARIADB_BIN" -e"SET GLOBAL innodb_fast_shutdown = 0" || abort "Unable to prepare shutdown"
    unitctl "stop" "$MARIADB_UNIT"

    log "Configure MariaDB settings"
    cat <<EOF >"$MARIADB_CONFIG_FILE" || abort "Unable to create and edit file '${MARIADB_CONFIG_FILE}'"
[mysqld]

# This is the number 1 setting to look at for any performance optimization
# It is where the data and indexes are cached: having it as large as possible will
# ensure MySQL uses memory and not disks for most read operations.
# See https://mariadb.com/kb/en/innodb-buffer-pool/
# Typical values are 1G (1-2GB RAM), 5-6G (8GB RAM), 20-25G (32GB RAM), 100-120G (128GB RAM).
innodb_buffer_pool_size = ${MARIADB_INNODB_BUFFER_POOL_SIZE}
# Redo log file size, the higher the better.
# MySQL/MariaDB writes one of these log files in a default installation.
innodb_log_file_size = 512M
innodb_sort_buffer_size = 64M
sort_buffer_size = 262144 # default
join_buffer_size = 262144 # default
max_allowed_packet = 128M
max_heap_table_size = 32M
query_cache_min_res_unit = 4096
query_cache_type = 1
query_cache_limit = 5M
query_cache_size = 80M
tmp_table_size = 32M
max_connections = 200
innodb_file_per_table = 1
# Disable this (= 0) if you have slow hard disks
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT
innodb_lru_scan_depth = 2048
table_definition_cache = 1024
table_open_cache = 2048
innodb_stats_on_metadata = 0
# The maximum number of instances is defined by the table_open_cache_instances system variable.
# The default value of the table_open_cache_instances system variable is 8, which is expected to handle up to 100 CPU cores.
# If your system is larger than this, then you may benefit from increasing the value of this system variable.
table_open_cache_instances = 8
sql-mode = ""
EOF

    unitctl "start" "$MARIADB_UNIT"
}

## MariaDB's root keeps logging in via unix socket. i-doit gets its own administrator:
function secureMariaDB {
    local user=""
    local password=""

    "$MARIADB_BIN" -e"SELECT 1" >/dev/null ||
        abort "Unable to log in to MariaDB as root via unix socket"

    askPassword MARIADB_SUPERUSER_PASSWORD "a password for the new MariaDB user '${MARIADB_SUPERUSER_USERNAME}'"

    log "Remove anonymous users, remote access for root and test database"
    "$MARIADB_BIN" <<'EOF' || abort "SQL statement failed"
DELETE FROM mysql.global_priv WHERE User = '' OR (User = 'root' AND Host NOT IN ('localhost', '127.0.0.1', '::1'));
DROP DATABASE IF EXISTS test;
DELETE FROM mysql.db WHERE Db = 'test' OR Db = 'test\_%';
FLUSH PRIVILEGES;
EOF

    user=$(sqlString "$MARIADB_SUPERUSER_USERNAME")
    password=$(sqlString "$MARIADB_SUPERUSER_PASSWORD")

    log "Create MariaDB user '${MARIADB_SUPERUSER_USERNAME}' with all privileges"
    "$MARIADB_BIN" <<EOF || abort "SQL statement failed"
CREATE USER IF NOT EXISTS ${user}@'localhost';
ALTER USER ${user}@'localhost' IDENTIFIED BY ${password};
GRANT ALL PRIVILEGES ON *.* TO ${user}@'localhost' WITH GRANT OPTION;
FLUSH PRIVILEGES;
EOF

    storeCredential "MariaDB administrator" "$MARIADB_SUPERUSER_USERNAME" "$MARIADB_SUPERUSER_PASSWORD"
    MARIADB_SUPERUSER_READY=1
}

## The installation needs a MariaDB user who may create databases and users:
function requireMariaDBSuperuser {
    if [[ "$MARIADB_SUPERUSER_READY" = 1 ]]; then
        return 0
    fi

    log "i-doit needs a MariaDB user who is allowed to create databases and users."

    if isUnattended; then
        if [[ -z "$MARIADB_SUPERUSER_PASSWORD" ]]; then
            abort "Please set MARIADB_SUPERUSER_USERNAME and MARIADB_SUPERUSER_PASSWORD"
        fi
    else
        echo -n -e "Please enter the username of this MariaDB user [leave empty for '${MARIADB_SUPERUSER_USERNAME}']: "
        readAnswer

        if [[ -n "$answer" ]]; then
            MARIADB_SUPERUSER_USERNAME="$answer"
        fi

        if [[ -z "$MARIADB_SUPERUSER_PASSWORD" ]]; then
            echo -n -e "Please enter the password of MariaDB user '${MARIADB_SUPERUSER_USERNAME}': "
            read -rs MARIADB_SUPERUSER_PASSWORD
            echo ""
        fi
    fi

    mariadbSuperuser -e"SELECT 1" >/dev/null ||
        abort "Unable to log in to MariaDB as '${MARIADB_SUPERUSER_USERNAME}'"

    MARIADB_SUPERUSER_READY=1
}

## Run the MariaDB client as MariaDB administrator without a password on the command line:
function mariadbSuperuser {
    local config="${TMP_DIR}/mariadb-superuser.cnf"

    install -m 0600 /dev/null "$config" || abort "Unable to create file '${config}'"

    {
        echo "[client]"
        echo "host=$(cnfString "$MARIADB_HOSTNAME")"
        echo "user=$(cnfString "$MARIADB_SUPERUSER_USERNAME")"
        echo "password=$(cnfString "$MARIADB_SUPERUSER_PASSWORD")"
    } >"$config" || abort "Unable to edit file '${config}'"

    "$MARIADB_BIN" --defaults-extra-file="$config" "$@"
}

function isLocalMariaDB {
    [[ "$MARIADB_HOSTNAME" = "localhost" || "$MARIADB_HOSTNAME" = "127.0.0.1" || "$MARIADB_HOSTNAME" = "::1" ]]
}

## Quote a value as SQL string literal:
function sqlString {
    local value="$1"
    local bs="\\"
    local sq="'"

    value="${value//"$bs"/"$bs$bs"}"
    value="${value//"$sq"/"$sq$sq"}"
    printf "'%s'" "$value"
}

## Quote a value for a MariaDB option file:
function cnfString {
    local value="$1"
    local bs="\\"
    local dq='"'

    value="${value//"$bs"/"$bs$bs"}"
    value="${value//"$dq"/"$bs$dq"}"
    printf '"%s"' "$value"
}

## Ask for a password unless the variable is already set. No input generates one.
## The optional third argument lists characters the password must not contain:
function askPassword {
    local var="$1"
    local description="$2"
    local forbidden="${3:-}"
    local first=""
    local second=""

    if [[ -n "${!var}" ]]; then
        if containsAnyChar "${!var}" "$forbidden"; then
            abort "${var} must not contain any of these characters: $(listChars "$forbidden")"
        fi

        log "Use ${description} from environment variable ${var}"
        return 0
    fi

    if ! isUnattended; then
        while true; do
            echo -n -e "Please enter ${description} [leave empty to generate one]: "
            read -rs first
            echo ""

            if [[ -z "$first" ]]; then
                break
            fi

            if containsAnyChar "$first" "$forbidden"; then
                log "The password must not contain any of these characters: $(listChars "$forbidden")"
                log "Please try again."
                continue
            fi

            echo -n -e "Please repeat the password: "
            read -rs second
            echo ""

            if [[ "$first" = "$second" ]]; then
                break
            fi

            log "Passwords do not match. Please try again."
        done
    fi

    if [[ -z "$first" ]]; then
        first=$(openssl rand -hex 16) || abort "Unable to generate password"
        log "Generated ${description}"
    fi

    printf -v "$var" '%s' "$first"
}

## Check whether a value contains at least one of the given characters:
function containsAnyChar {
    local value="$1"
    local chars="$2"
    local i=0

    for ((i = 0; i < ${#chars}; i++)); do
        if [[ "$value" = *"${chars:i:1}"* ]]; then
            return 0
        fi
    done

    return 1
}

## Print the given characters separated by spaces:
function listChars {
    local chars="$1"
    local list=""
    local i=0

    for ((i = 0; i < ${#chars}; i++)); do
        list+="${list:+ }${chars:i:1}"
    done

    printf '%s' "$list"
}

## Keep all credentials in one file which only root may read:
function storeCredential {
    local description="$1"
    local username="$2"
    local password="$3"

    if [[ ! -f "$CREDENTIALS_FILE" ]]; then
        install -m 0600 /dev/null "$CREDENTIALS_FILE" || abort "Unable to create file '${CREDENTIALS_FILE}'"
    fi

    chmod 0600 "$CREDENTIALS_FILE" || abort "Unable to change permissions of '${CREDENTIALS_FILE}'"

    ## Each run gets its own section; on a rerun the last section holds the current passwords:
    if [[ "$CREDENTIALS_HEADER_WRITTEN" = 0 ]]; then
        if [[ -s "$CREDENTIALS_FILE" ]]; then
            log "File '${CREDENTIALS_FILE}' contains passwords of a previous run. Add a new section; older entries may be outdated."
            echo "" >>"$CREDENTIALS_FILE" || abort "Unable to edit file '${CREDENTIALS_FILE}'"
        fi

        echo "## i-doit installation, $(date -R); entries of this section replace older ones" >>"$CREDENTIALS_FILE" ||
            abort "Unable to edit file '${CREDENTIALS_FILE}'"
        CREDENTIALS_HEADER_WRITTEN=1
    fi

    printf '%s: username=%s password=%s\n' "$description" "$username" "$password" >>"$CREDENTIALS_FILE" ||
        abort "Unable to edit file '${CREDENTIALS_FILE}'"
}

## Ask for the variant before the first change of the system:
function askVariant {
    local variant=""

    log ""
    log "For evaluation use \033[32mEVAL\033[0m"
    log "If you have a license use \033[32mPRO\033[0m"
    log "If you want the open version use \033[32mOPEN\033[0m"
    log ""

    while true; do
        echo -n -e "Which variant of i-doit do you like to install? [eval|pro|open, leave empty for '${IDOIT_VARIANT}']: "

        readAnswer

        variant="${answer:-$IDOIT_VARIANT}"
        variant="${variant,,}"

        case "$variant" in
        "eval" | "pro" | "open")
            IDOIT_VARIANT="$variant"
            return 0
            ;;
        esac

        if isUnattended; then
            abort "Unknown variant '${variant}'. Please set IDOIT_VARIANT to eval, pro or open."
        fi

        log "Sorry, what do you mean?"
    done
}

function prepareIDoit {
    local file="${TMP_DIR}/i-doit.zip"
    local update_file_url=""
    local variant=""
    local parse_updates_script=""
    local url=""
    local version=""
    local release_date=""

    if [[ "$INSTALL_DIR_CONFIRMED" = 0 ]] && ! isInstallDirEmpty; then
        log "Directory '${INSTALL_DIR}' is not empty."

        if isUnattended; then
            abort "Refuse to remove files from '${INSTALL_DIR}'"
        fi

        if askNoYes "Do you really want to remove all files in '${INSTALL_DIR}'?"; then
            cancel
        fi
    fi

    log "Cleanup VHost directory"
    mkdir -p "$INSTALL_DIR" || abort "Unable to create directory '${INSTALL_DIR}'"
    rm -rf "${INSTALL_DIR:?}/"* || abort "Unable to remove files"
    rm -f "${INSTALL_DIR}"/.htaccess || abort "Unable to remove files"

    case "${IDOIT_VARIANT,,}" in
    "eval")
        update_file_url="$UPDATE_FILE_EVAL"
        variant="eval"
        ;;
    "pro")
        update_file_url="$UPDATE_FILE_PRO"
        variant="pro"
        ;;
    "open")
        update_file_url="$UPDATE_FILE_OPEN"
        variant="open"
        ;;
    *)
        abort "Unknown variant"
        ;;
    esac

    log "Install i-doit $variant"

    case "$variant" in
    "pro" | "open")
        log "Identify latest version of i-doit $variant"
        "$WGET_BIN" --quiet -O "${TMP_DIR}/updates.xml" "$update_file_url" ||
            abort "Unable to fetch file from '${update_file_url}'"
        test -s "$TMP_DIR/updates.xml" || abort "File '${update_file_url}' is empty"

        parse_updates_script="${TMP_DIR}/parseupdates.php"

        cat <<EOF >"$parse_updates_script" || abort "Unable to create and edit file '${parse_updates_script}'"
