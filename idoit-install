function updateApacheConfig {
    local htaccessFile="${INSTALL_DIR}/.htaccess"

    local configFile=""

    log "Update Apache's VHost config from i-doit's htaccess file"

    [[ -s "$htaccessFile" ]] || abort "Missing or empty file '${htaccessFile}'"

    for configFile in "$APACHE_CONFIG_FILE" "$APACHE_SSL_CONFIG_FILE"; do
        if [[ ! -f "$configFile" ]]; then
            continue
        fi

        sed -i \
            -e "/${APACHE_HTACCESS_SUBSTITUTION}/ {" \
            -e "r ${htaccessFile}" \
            -e "d" \
            -e "}" \
            "$configFile" || abort "Unable to change config file '${configFile}'"
    done

    unitctl "restart" "$APACHE_UNIT"
}

function installIDoit {
    local prefix="php"
    local console="${INSTALL_DIR}/console.php"
    local config_file="${INSTALL_DIR}/src/config.inc.php"

    log "Install i-doit via console.php"

    requireMariaDBSuperuser

    askPassword IDOIT_ADMIN_CENTER_PASSWORD "a password for the i-doit Admin Center"

    echo -n -e \
        "Please enter a username for a new MySQL user (This user will be authorized to the i-doit databases only) [leave empty for '${MARIADB_IDOIT_USERNAME}']: "
    readAnswer

    if [[ -n "$answer" ]]; then
        MARIADB_IDOIT_USERNAME="$answer"
    fi

    askPassword MARIADB_IDOIT_PASSWORD "a password for the new MariaDB user '${MARIADB_IDOIT_USERNAME}'" "$MARIADB_IDOIT_PASSWORD_FORBIDDEN_CHARS"

    ## Keep generated passwords even if the installation fails:
    storeCredential "i-doit Admin Center" "admin" "$IDOIT_ADMIN_CENTER_PASSWORD"
    storeCredential "MariaDB user for i-doit" "$MARIADB_IDOIT_USERNAME" "$MARIADB_IDOIT_PASSWORD"

    sudo -u "${APACHE_USER}" "${prefix}" "${console}" install \
        -u "$MARIADB_SUPERUSER_USERNAME" \
        -p "$MARIADB_SUPERUSER_PASSWORD" \
        --host="$MARIADB_HOSTNAME" \
        -d idoit_system \
        -U "$MARIADB_IDOIT_USERNAME" \
        -P "$MARIADB_IDOIT_PASSWORD" \
        --admin-password "$IDOIT_ADMIN_CENTER_PASSWORD" \
        -n || abort "Installation of i-doit failed"

    log "Fix configuration file '${config_file}'"

    chown "$APACHE_USER":"$APACHE_GROUP" "$config_file" || abort "Unable to change ownership"
}

function create_tenant {
    local prefix="php"
    local console="${INSTALL_DIR}/console.php"
    local tenant_name="$IDOIT_DEFAULT_TENANT"

    log "Create the first tenant via console.php"
    echo -n -e \
        "Please enter a tenant name [leave empty for '${tenant_name}']: "
    readAnswer

    if [[ -n "$answer" ]]; then
        tenant_name="$answer"
    fi

    askPassword IDOIT_ADMIN_PASSWORD "a password for the i-doit user 'admin'" "$IDOIT_ADMIN_PASSWORD_FORBIDDEN_CHARS"

    ## Keep a generated password even if creating the tenant fails:
    storeCredential "i-doit user in tenant '${tenant_name}'" "admin" "$IDOIT_ADMIN_PASSWORD"

    sudo -u "${APACHE_USER}" "${prefix}" "${console}" tenant-create \
        -u "$MARIADB_SUPERUSER_USERNAME" \
        -p "$MARIADB_SUPERUSER_PASSWORD" \
        -U "$MARIADB_IDOIT_USERNAME" \
        -P "$MARIADB_IDOIT_PASSWORD" \
        -d idoit_data \
        -t "$tenant_name" \
        --login-user admin \
        --login-password "$IDOIT_ADMIN_PASSWORD" \
        -n || abort "Creating tenant failed"

    log "Tenant '$tenant_name' created"
}

## Use the first active tenant for cron jobs and backups:
function findTenant {
    local tenant=""

    requireMariaDBSuperuser

    tenant=$(mariadbSuperuser --batch --skip-column-names \
        -e"SELECT isys_mandator__id, isys_mandator__db_name FROM idoit_system.isys_mandator WHERE isys_mandator__active = 1 ORDER BY isys_mandator__id LIMIT 1;") ||
        abort "Unable to read tenants from system database"

    if [[ -z "$tenant" ]]; then
        return 1
    fi

    IFS=$'\t' read -r TENANT_ID TENANT_DATABASE <<<"$tenant"
    log "Use tenant ${TENANT_ID} with database '${TENANT_DATABASE}'"
}

function deployScriptSettings {
    local settings_dir=""

    log "Deploy script settings"

    settings_dir=$(dirname "$SCRIPT_SETTINGS")

    mkdir -p "$settings_dir" || abort "Unable to create directory '$settings_dir'"

    install -m 0600 /dev/null "$SCRIPT_SETTINGS" || abort "Unable to create file '${SCRIPT_SETTINGS}'"

    {
        echo "#!/bin/bash"
        echo ""
        shellExport CONSOLE_BIN "$CONSOLE_BIN"
        shellExport CONSOLE_CONFIG "$CONSOLE_CONFIG"
        shellExport APACHE_USER "$APACHE_USER"
        shellExport SYSTEM_DATABASE "idoit_system"
        shellExport TENANT_DATABASE "$TENANT_DATABASE"
        shellExport TENANT_ID "$TENANT_ID"
        shellExport MARIADB_USERNAME "$MARIADB_IDOIT_USERNAME"
        shellExport MARIADB_PASSWORD "$MARIADB_IDOIT_PASSWORD"
        shellExport MARIADB_HOSTNAME "$MARIADB_HOSTNAME"
        shellExport INSTANCE_PATH "$INSTALL_DIR"
        shellExport BACKUP_DIR "$BACKUP_DIR"
        echo "# Max. age of backup files (in days):"
        echo "export BACKUP_AGE=30"
    } >"$SCRIPT_SETTINGS" || abort "Unable to edit file '${SCRIPT_SETTINGS}'"

    if [[ -z "$IDOIT_ADMIN_PASSWORD" ]]; then
        if isUnattended; then
            abort "Please set IDOIT_ADMIN_PASSWORD to the password of the i-doit user 'admin'"
        fi

        while true; do
            echo -n -e "Please enter the password of the i-doit user 'admin' for the cron jobs: "
            read -rs IDOIT_ADMIN_PASSWORD
            echo ""

            if ! containsAnyChar "$IDOIT_ADMIN_PASSWORD" "$IDOIT_ADMIN_PASSWORD_FORBIDDEN_CHARS"; then
                break
            fi

            log "The password must not contain any of these characters: $(listChars "$IDOIT_ADMIN_PASSWORD_FORBIDDEN_CHARS")"
            log "Please try again."
        done
    fi

    if containsAnyChar "$IDOIT_ADMIN_PASSWORD" "$IDOIT_ADMIN_PASSWORD_FORBIDDEN_CHARS"; then
        abort "The password of the i-doit user 'admin' must not contain double quotes"
    fi

    log "Deploy settings for the i-doit console to '${CONSOLE_CONFIG}'"

    install -m 0640 -o root -g "$APACHE_GROUP" /dev/null "$CONSOLE_CONFIG" ||
        abort "Unable to create file '${CONSOLE_CONFIG}'"

    {
        echo "[commandOptions]"
        echo "user=admin"
        echo "password=\"${IDOIT_ADMIN_PASSWORD}\""
        echo "tenantId=${TENANT_ID}"
    } >"$CONSOLE_CONFIG" || abort "Unable to edit file '${CONSOLE_CONFIG}'"
}

## Print a line for a shell file which exports a variable in double quotes:
function shellExport {
    local value="$2"
    local bs="\\"
    local char=""

    for char in "$bs" '"' '$' '`'; do
        value="${value//"$char"/"$bs$char"}"
    done

    printf 'export %s="%s"\n' "$1" "$value"
}

