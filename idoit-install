        ## The AppArmor profile of PHP-FPM blocks i-doit, see the knowledge base:
        if [[ -f /etc/apparmor.d/php-fpm ]]; then
            if [[ ! -x "$(command -v aa-complain)" ]]; then
                log "Install AppArmor utilities"
